# Auth: by default the Agent SDK reuses your local Claude CLI login
# (run `claude /login` once and the SDK will use that subscription for
# all role sessions). Set ANTHROPIC_API_KEY only if you want to bill
# runs against an API account instead.
#
# ANTHROPIC_API_KEY=sk-ant-...

PORT=5174
HOST=127.0.0.1
LOG_LEVEL=info

# Default Claude model for every role session.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional per-role overrides (fall back to CLAUDE_MODEL). The launch dialog can
# also override any role's model for a single run.
# CLAUDE_MODEL_ANALYST=claude-opus-5-5
# CLAUDE_MODEL_DEVELOPER=claude-sonnet-5-5
# CLAUDE_MODEL_UNIT_TESTER=claude-sonnet-5-5
# CLAUDE_MODEL_INTEGRATION_TESTER=claude-sonnet-5-5
# CLAUDE_MODEL_REVIEWER=claude-opus-5-5
# CLAUDE_MODEL_E2E_TESTER=claude-sonnet-5-5
# CLAUDE_MODEL_PR_CREATOR=claude-haiku-5-5

# Fix loops (review sent back, or a tester handing an app-bug back to the
# Developer) allowed before the run pauses for you. 0 = unlimited.
# MAX_FIX_ITERATIONS=3

# Total USD a run may spend; once reached, the run pauses before the next role.
# 0 = unlimited. "Jump" in the UI continues past the budget for one role.
# MAX_RUN_COST_USD=0

# When true, the Reviewer gate is decided from review-findings.json: any
# BLOCKER/HIGH goes straight back to the Developer, otherwise on to E2E tests.
# REVIEW_AUTO_ROUTE=false

# Optional. If a run's target repo contains a folder at this relative path,
# role prompts tell the agents to consult it as the project's AI guideline doc
# (coding conventions, architecture rules, review rubric for the AI to follow).
# Set to empty to disable the default. The launch dialog can override this per
# repo per run.
AI_GUIDELINE_PATH_DEFAULT=docs/ai-guideline

# Retry policy for transient SDK errors (network reset, timeout, 5xx).
# RUN_RETRY_MAX_ATTEMPTS=3
# RUN_RETRY_INITIAL_DELAY_MS=1000

# Template for the per-repo implementation branch name. Substitutions:
#   {ticket} — the JIRA key, lowercased (e.g. proj-123)
#   {slug}   — a short slug derived from the Analyst's feature title
# The user can override every branch name individually in the approval UI
# before anything is created.
# For manual-source runs {ticket} resolves to a slug of the user-supplied title.
# BRANCH_NAME_TEMPLATE=feature/{ticket}-{slug}
