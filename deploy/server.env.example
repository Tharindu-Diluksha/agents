# Server mode settings for the `orchestrator` service in docker-compose.yml.
#   cp deploy/server.env.example deploy/server.env   (gitignored)
# AUTH_MODE, KEYCLOAK_ISSUER, KEYCLOAK_INTERNAL_URL, PUBLIC_URL and DATABASE_URL
# are set in docker-compose.yml (they override this file). See deploy/README.md.

# --- Sign-in (required) ---
# Must match the orchestrator-web client secret in Keycloak (the dev realm ships
# "dev-only-change-me"; change both for anything shared).
KEYCLOAK_CLIENT_SECRET=dev-only-change-me
# At least 32 random characters, stable across restarts: openssl rand -base64 48
SESSION_SECRET=

# --- Claude (one of these) ---
# API billing:
# ANTHROPIC_API_KEY=sk-ant-...
# Or a Claude subscription: run `claude setup-token` on your machine and paste the token.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub (clones, pushes, `gh pr create`) ---
# A token with contents:write and pull_requests:write on the target repos.
# GH_TOKEN=
# GH_HOST=github.com
# Author of the commits roles make.
# GIT_USER_NAME=Agent Orchestrator
# GIT_USER_EMAIL=orchestrator@example.com

# --- Which repos may be launched ---
# Comma-separated URL prefixes; empty = any URL. Local paths are off in the image.
# ALLOWED_REPO_URLS=https://github.com/my-org/
# ALLOW_LOCAL_REPO_PATHS=false
# Mounted repos owned by another uid (git "dubious ownership"): paths, or *.
# GIT_SAFE_DIRECTORIES=/srv/git/app,/srv/git/api

# --- Models, limits ---
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL_REVIEWER=claude-opus-5-5
# MAX_CONCURRENT_ROLES=2
# MAX_FIX_ITERATIONS=3
# MAX_RUN_COST_USD=0

# --- JIRA MCP (an HTTP/SSE server; stdio servers would need their binary in the image) ---
# JIRA_MCP_SERVER_NAME=jira
# JIRA_MCP_TRANSPORT=http
# JIRA_MCP_URL=https://mcp.example.com/jira
# JIRA_MCP_HEADERS={"Authorization":"Bearer ..."}
# Or mount a jira-mcp.json and point at it:
# JIRA_MCP_CONFIG=/data/jira-mcp.json

# --- Behind a reverse proxy ---
# TRUST_PROXY=true
# Extra hostnames besides the PUBLIC_URL host:
# ALLOWED_HOSTS=
